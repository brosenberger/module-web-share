<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <catalog>
            <web_share>
                <enabled>1</enabled>
                <on_product>1</on_product>
                <on_category>1</on_category>
                <on_listing>1</on_listing>
                <copy_link>1</copy_link>
                <share_text>{{title}}</share_text>
                <providers>{"whatsapp":{"label":"WhatsApp","url_template":"https://wa.me/?text={{text}}%20{{url}}","active":"1"},"facebook":{"label":"Facebook","url_template":"https://www.facebook.com/sharer/sharer.php?u={{url}}","active":"1"},"x":{"label":"X","url_template":"https://x.com/intent/tweet?text={{text}}&amp;url={{url}}","active":"1"},"linkedin":{"label":"LinkedIn","url_template":"https://www.linkedin.com/sharing/share-offsite/?url={{url}}","active":"1"},"pinterest":{"label":"Pinterest","url_template":"https://www.pinterest.com/pin/create/button/?url={{url}}&amp;media={{image}}&amp;description={{text}}","active":"1"},"email":{"label":"Email","url_template":"mailto:?subject={{title}}&amp;body={{text}}%0A%0A{{url}}","active":"1"}}</providers>
            </web_share>
        </catalog>
    </default>
</config>
