<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="catalog">
            <group id="web_share" translate="label comment" sortOrder="910" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Web Share</label>
                <comment>A "Share" button that opens the device's native share sheet (Web Share API). Where the browser has none, it shows the share links below instead.</comment>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="on_product" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Show on Product Pages</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="on_category" translate="label comment" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Show on Category Pages</label>
                    <comment>Shares the category's own URL, without layered-navigation filters or sorting.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="on_listing" translate="label comment" type="select" sortOrder="35" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Show on Product Lists</label>
                    <comment>A share icon on every product tile of category and search result pages, sharing that product's page.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="copy_link" translate="label" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Offer "Copy Link" in the Fallback</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="share_text" translate="label comment" type="text" sortOrder="45" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Share Text</label>
                    <comment><![CDATA[Sent with the link, e.g. <code>Found this at our shop: {{title}}</code>. <code>{{title}}</code> is replaced by the product, category or page title. Used by the native share sheet and as <code>{{text}}</code> in the share links below. Facebook and LinkedIn only use the link itself and build their preview from the page's Open Graph tags.]]></comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="providers" translate="label comment" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Fallback Share Links</label>
                    <comment><![CDATA[Shown when the browser has no native share sheet, in this order. Placeholders: <code>{{url}}</code>, <code>{{title}}</code>, <code>{{text}}</code>, <code>{{image}}</code> (URL-encoded). Set <em>Active</em> to No to hide a link without deleting its template. Only <code>https:</code>, <code>http:</code> and <code>mailto:</code> links are rendered.]]></comment>
                    <frontend_model>BroCode\WebShare\Block\Adminhtml\Form\Field\Providers</frontend_model>
                    <backend_model>Magento\Config\Model\Config\Backend\Serialized\ArraySerialized</backend_model>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>
        </section>
    </system>
</config>
