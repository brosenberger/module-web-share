<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="category.view.container">
            <block class="BroCode\WebShare\Block\Share" name="brocode.web.share.category" after="-">
                <arguments>
                    <argument name="share_source" xsi:type="string">category</argument>
                </arguments>
            </block>
        </referenceContainer>
        <referenceBlock name="category.product.addto">
            <block class="BroCode\WebShare\Block\ListingShare" name="category.product.addto.brocode_web_share" as="brocode_web_share" after="-"/>
        </referenceBlock>
    </body>
</page>
